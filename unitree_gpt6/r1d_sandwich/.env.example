# Nothing in this file is required. Copy it to <package root>/.env to change a default; .env is read
# automatically, and a shell environment variable of the same name takes priority.

# Interpreter for `bash r1d ...`; default .venv/bin/python, then python3.
# R1D_SANDWICH_PYTHON=/path/to/python
# A unitree_sdk2_python checkout to use instead of the installed unitree_sdk2py package.
# UNITREE_SDK2_ROOT=/path/to/unitree_sdk2_python
# Another R1-D URDF for the camera model; default assets/r1d/r1d.urdf.
# R1D_URDF=/path/to/r1d.urdf
# SERVER_URL=http://127.0.0.1:8765
# RUNS_DIR=/absolute/path/to/runs
