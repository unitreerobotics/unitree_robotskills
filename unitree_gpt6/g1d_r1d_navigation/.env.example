# Local environment example: copy to <skill dir>/navi.env (not committed); scripts/start.sh loads it on launch.
# Local paths only. Never put model API keys here -- if not exported, start.sh prompts for them (no echo, never saved).
DSH_DIR=/path/to/deepseek-harness
NAVI_PYTHON=/path/to/python
# Optional switches
# NAVI_CAMERA_VIEW=0
# NAVI_OBSERVER_PORT=0
# NAVI_RUN_LOG=0
