{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gomoku verified experience store",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "robot_id",
        "scene_id",
        "config_sha256",
        "calibration_sha256",
        "model_sha256",
        "reset_sha256"
      ],
      "properties": {
        "robot_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "calibration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "kind",
        "target",
        "measured",
        "verification",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "geometry",
            "grasp",
            "alignment",
            "release",
            "return",
            "placement"
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "measured": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "verification": {
          "type": "object",
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "geometry"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "required": [
                  "calibration_verified"
                ],
                "properties": {
                  "calibration_verified": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "grasp"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "required": [
                  "single_stone_held"
                ],
                "properties": {
                  "single_stone_held": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "alignment"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "required": [
                  "selected_intersection_verified"
                ],
                "properties": {
                  "selected_intersection_verified": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "release"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "required": [
                  "release_completed"
                ],
                "properties": {
                  "release_completed": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "return"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "required": [
                  "reset_joint_verified"
                ],
                "properties": {
                  "reset_joint_verified": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "placement"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "required": [
                  "physical_placement_verified"
                ],
                "properties": {
                  "physical_placement_verified": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "round_id",
        "recorded_at_utc",
        "round_state_sha256",
        "context",
        "kind",
        "target",
        "measured",
        "verification",
        "evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "geometry",
            "grasp",
            "alignment",
            "release",
            "return",
            "placement"
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "measured": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "verification": {
          "type": "object",
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "round_id": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "round_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "geometry"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "required": [
                  "calibration_verified"
                ],
                "properties": {
                  "calibration_verified": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "grasp"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "required": [
                  "single_stone_held"
                ],
                "properties": {
                  "single_stone_held": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "alignment"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "required": [
                  "selected_intersection_verified"
                ],
                "properties": {
                  "selected_intersection_verified": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "release"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "required": [
                  "release_completed"
                ],
                "properties": {
                  "release_completed": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "return"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "required": [
                  "reset_joint_verified"
                ],
                "properties": {
                  "reset_joint_verified": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "placement"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "required": [
                  "physical_placement_verified"
                ],
                "properties": {
                  "physical_placement_verified": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "observations"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/context"
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  }
}
