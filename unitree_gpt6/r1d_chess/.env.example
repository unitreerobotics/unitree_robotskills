# 程序不会自动加载本文件。需要时：set -a; source .env; set +a
# bash r1d 使用的 Python 解释器；空则用 <包根>/.venv/bin/python（存在时），否则 PATH 上的 python3
R1D_CHESS_PYTHON=
# 支持 xiangqi 的 Fairy-Stockfish（largeboards=yes）；空则用 PATH 上的 fairy-stockfish
CHESS_ENGINE=
# 覆盖运动学 URDF；空则用 config/runtime.json 的 model_urdf（assets/models/r1d/r1d.urdf）。
# 哈希必须与 config/robot.json 的 kinematic_model_sha256 一致，一般不要设置。
R1D_MODEL_URDF=
