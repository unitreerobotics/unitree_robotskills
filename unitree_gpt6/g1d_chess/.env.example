# Copy to .env, fill actual values, then load explicitly from the repository root:
# set -a; source .env; set +a
# Activate your Python environment separately before running scripts.
# Installed Fairy-Stockfish executable supporting xiangqi; empty means fairy-stockfish on PATH.
CHESS_ENGINE=
# Actual DDS interface and camera server, verified on the target robot.
CHESS_INTERFACE=
CHESS_CAMERA_HOST=
# Local service endpoint, shared by service and client.
CHESS_ENDPOINT=ipc:///tmp/g1d_chess.sock
# Internal Dex1 default for both hands: +1; positive q opens, q=0 closes.
# Keep this across host/Python/network changes; override only for a different joint convention.
CHESS_GRIPPER_SIGN=1
